{
  "name": "notion-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "tsc --noEmit && npm run clean && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=build/index.js",
    "start": "node build/index.js",
    "test": "npm run build && node --test test/server.test.js test/selection.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@notionhq/client": "^5.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
